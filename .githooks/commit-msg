#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════════
# OpenClaw Commit-Msg Hook — "Da li commit poruka ima smisla?"
# ═══════════════════════════════════════════════════════════════════════════════
# Validira:
#   1. Conventional Commits format (feat/fix/docs/refactor/test/chore/ci/perf/checkpoint)
#   2. Minimalna dužina subjekta (>10 karaktera)
#   3. Nema praznih/WIP commit poruka bez --no-verify
#   4. Nema duplikatnih poruka (isti tekst kao prethodni commit)
# ═══════════════════════════════════════════════════════════════════════════════
set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Strip comments
MSG_CLEAN=$(echo "$COMMIT_MSG" | grep -v '^#' | sed '/^$/d' | head -1)

red()   { printf "\033[31m%s\033[0m\n" "$*"; }
green() { printf "\033[32m%s\033[0m\n" "$*"; }
bold()  { printf "\033[1m%s\033[0m\n" "$*"; }

# ── 1. Prazna poruka ────────────────────────────────────────────────────────
if [ -z "$MSG_CLEAN" ]; then
    red "❌ Prazna commit poruka! Opišite šta ste uradili."
    exit 1
fi

# ── 2. Conventional Commits format ──────────────────────────────────────────
# Dozvoljen format: type(scope): subject  ili  type: subject
TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|checkpoint|wip|hotfix"
PATTERN="^(${TYPES})(\([a-zA-Z0-9._/-]+\))?(!)?:\s+.+"

if ! echo "$MSG_CLEAN" | grep -qE "$PATTERN"; then
    red "❌ Commit poruka NE prati Conventional Commits format!"
    red "   Dobijeno:  '${MSG_CLEAN}'"
    red "   Očekivano: 'type(scope): opis promene'"
    red ""
    red "   Dozvoljeni tipovi: ${TYPES}"
    red "   Primeri:"
    red "     fix(nlm): correct nlm notebook query syntax"
    red "     feat(debate): add round-based persona agendas"
    red "     checkpoint: NLM fix and notebook ID sync"
    exit 1
fi

# ── 3. Minimalna dužina subjekta ────────────────────────────────────────────
SUBJECT=$(echo "$MSG_CLEAN" | sed -E "s/^(${TYPES})(\([^)]*\))?(!)?: *//" )
if [ "${#SUBJECT}" -lt 10 ]; then
    red "❌ Commit subjekt prekratak: '${SUBJECT}' (${#SUBJECT} < 10 karaktera)"
    red "   Opišite šta je agent zaista promenio."
    exit 1
fi

# ── 4. Provera duplikata — isti tekst kao poslednji commit? ─────────────────
LAST_MSG=$(git log --oneline -1 --format='%s' 2>/dev/null || echo "")
if [ -n "$LAST_MSG" ] && [ "$MSG_CLEAN" = "$LAST_MSG" ]; then
    red "❌ Duplikat! Ista commit poruka kao prethodni commit: '${LAST_MSG}'"
    red "   Promenite poruku da odražava šta je novo urađeno."
    exit 1
fi

# ── 5. Maksimalna dužina (72 char subject line) ────────────────────────────
if [ "${#MSG_CLEAN}" -gt 100 ]; then
    printf "\033[33m  ⚠️  Subject line je dugačak (%d > 72 karaktera) — ali dozvoljen\033[0m\n" "${#MSG_CLEAN}"
fi

green "✅ Commit poruka validna: '${MSG_CLEAN}'"
exit 0
